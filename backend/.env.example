# ---- Agora (console.agora.io -> Project -> App ID / Certificate; RESTful API -> Customer key/secret)
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_CUSTOMER_KEY=
AGORA_CUSTOMER_SECRET=
AGORA_AGENT_UID=sentinel
AGORA_ASR_VENDOR=ares
AGORA_ASR_LANGUAGE=en-US
AGORA_TTS_VENDOR=openai
AGORA_TTS_PARAMS_JSON={"url":"https://api.openai.com/v1/audio/speech","model":"tts-1","voice":"alloy","speed":1}
# Leave AGORA_TTS_API_KEY blank to use Agora-managed credentials (Agora supplies the vendor key, billed via Agora)
AGORA_TTS_API_KEY=

# Public URL Agora uses to reach this backend's /v1/chat/completions (ngrok/cloudflared in dev)
PUBLIC_BASE_URL=https://your-tunnel.ngrok.app
SENTINEL_LLM_API_KEY=sentinel-dev-key

# ---- LLM (OpenAI-compatible). Leave key blank to run the rule-based extractor offline.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Gemini via OpenAI-compat: LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/  LLM_MODEL=gemini-2.5-flash

# ---- Integrations (blank => realistic mocks)
SLACK_BOT_TOKEN=
SLACK_CHANNEL=#incidents
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=INC
PAGERDUTY_API_KEY=
PAGERDUTY_SERVICE_ID=
DEMO_MODE=true
REPORT_TIMEZONE=Asia/Kolkata

# ---- GitHub (linked repo = incident evidence). Public repos work with no token.
GITHUB_TOKEN=
GITHUB_DEFAULT_REPO=NerdNinzas/Sentinel

# ---- Auth & persistence
MONGODB_URL=
AUTH_REQUIRED=true
# GitHub OAuth app (Settings -> Developer settings -> OAuth Apps). Callback: {PUBLIC_BASE_URL}/api/auth/github/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
FRONTEND_URL=http://localhost:3000
# If Agora's managed TTS 500s ("model service temporarily unavailable"), bring your own key instead:
#   ElevenLabs (free tier): AGORA_TTS_VENDOR=elevenlabs  AGORA_TTS_API_KEY=<xi-api-key>
#   AGORA_TTS_PARAMS_JSON={"model_id":"eleven_flash_v2_5","voice_id":"21m00Tcm4TlvDq8ikWAM"}

# ---- Email (invitations) via Resend — resend.com free tier
RESEND_API_KEY=
RESEND_FROM=Sentinel <onboarding@resend.dev>

# ---- Live demo service (deployed payment API). When set, Sentinel polls its
# /health + /logs as real monitoring and runs a small load generator against /pay.
MONITOR_URL=
LOADGEN_RPS=2
