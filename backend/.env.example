# ---- Agora (console.agora.io -> Project -> App ID / Certificate; RESTful API -> Customer key/secret)
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_CUSTOMER_KEY=
AGORA_CUSTOMER_SECRET=
AGORA_AGENT_UID=sentinel
AGORA_ASR_VENDOR=ares
AGORA_ASR_LANGUAGE=en-US
AGORA_TTS_VENDOR=openai
AGORA_TTS_PARAMS_JSON={"model":"gpt-4o-mini-tts","voice":"alloy"}
AGORA_TTS_API_KEY=

# Public URL Agora uses to reach this backend's /v1/chat/completions (ngrok/cloudflared in dev)
PUBLIC_BASE_URL=https://your-tunnel.ngrok.app
SENTINEL_LLM_API_KEY=sentinel-dev-key

# ---- LLM (OpenAI-compatible). Leave key blank to run the rule-based extractor offline.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Gemini via OpenAI-compat: LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/  LLM_MODEL=gemini-2.5-flash

# ---- Integrations (blank => realistic mocks)
SLACK_BOT_TOKEN=
SLACK_CHANNEL=#incidents
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=INC
PAGERDUTY_API_KEY=
PAGERDUTY_SERVICE_ID=
DEMO_MODE=true
